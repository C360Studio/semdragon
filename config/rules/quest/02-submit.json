[
  {
    "id": "quest_submit_needs_review",
    "type": "expression",
    "name": "Quest submit (review required)",
    "description": "in_progress + command=submit + quest.review.needs_review=true -> in_review. The caller (questbridge, on loop completion) writes the work product to quest.data.output before stamping the command. Mutually exclusive with quest_submit_no_review via the needs_review value.",
    "enabled": true,
    "logic": "and",
    "rerun_on_recovery": true,
    "conditions": [
      { "field": "quest.status.state", "operator": "eq", "value": "in_progress" },
      { "field": "quest.command", "operator": "eq", "value": "submit" },
      { "field": "quest.review.needs_review", "operator": "eq", "value": true }
    ],
    "on_enter": [
      {
        "type": "lifecycle_transition",
        "workflow": "quest",
        "phase": "in_review",
        "reason": "command=submit, review required",
        "set": { "command": "consumed" }
      }
    ]
  },
  {
    "id": "quest_submit_no_review",
    "type": "expression",
    "name": "Quest submit (no review)",
    "description": "in_progress + command=submit + quest.review.needs_review=false -> completed. Mutually exclusive with quest_submit_needs_review.",
    "enabled": true,
    "logic": "and",
    "rerun_on_recovery": true,
    "conditions": [
      { "field": "quest.status.state", "operator": "eq", "value": "in_progress" },
      { "field": "quest.command", "operator": "eq", "value": "submit" },
      { "field": "quest.review.needs_review", "operator": "eq", "value": false }
    ],
    "on_enter": [
      {
        "type": "lifecycle_transition",
        "workflow": "quest",
        "phase": "completed",
        "reason": "command=submit, no review",
        "set": { "command": "consumed" }
      }
    ]
  }
]
